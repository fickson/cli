[workspace]

[package]
name = "{{ package_name }}"
version = "0.1.0"
edition = "2021"

[dependencies]
sekuire-sdk = { path = "../../packages/sdk" }
tokio = { version = "1.0", features = ["full"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
anyhow = "1.0"
reqwest = { version = "0.11", features = ["json"] }
