# Sekuire Configuration
# Generated by: sekuire init

# Project metadata
project:
  name: "{{ name }}"
  version: "0.1.0"
  description: "My compliant AI agent"
  author: ""
  license: "MIT"

# Identity Configuration (Required for Verification)
identity:
  model: "{{ llm_model }}"
  system_prompt_path: "{{ llm_primary_prompt_path }}"
  tools_path: "{{ llm_primary_tools_path }}"

# Installation / deployment metadata (displayed in the dashboard)
deployment:
  docker_image: "sekuire/agent:{{ name }}"
  notes: "List the environment variables this agent needs so enterprises can review and install safely."
  env:
{% if llm_requires_api_key %}
    - name: "{{ llm_api_key_env }}"
      required: true
      secret: true
      description: "{{ llm_provider_display }} API key for the agent LLM."
      example: "{{ llm_api_key_example }}"
{% endif %}
    - name: "LLM_MODEL"
      required: false
      secret: false
      description: "LLM model name."
      default_value: "{{ llm_model }}"
{% if llm_provider == "ollama" %}
    - name: "OLLAMA_BASE_URL"
      required: false
      secret: false
      description: "Ollama endpoint for local models."
      default_value: "${OLLAMA_BASE_URL:-http://localhost:11434}"
{% endif %}
    - name: "SEKUIRE_AGENT_ID"
      required: false
      secret: false
      description: "Agent id used for handshake/server."
      default_value: "{{ name }}"
    - name: "PORT"
      required: false
      secret: false
      description: "HTTP port (if you enable server mode)."
      default_value: "8000"
    - name: "HOST"
      required: false
      secret: false
      description: "Bind address."
      default_value: "0.0.0.0"

# LLM Configuration
# You can use environment variables for dynamic configuration
# Example: provider: "${LLM_PROVIDER:-openai}" uses env var with fallback
llm:
  provider: "{{ llm_provider }}"           # openai, anthropic, ollama, google
  model: "{{ llm_model }}"               # Model name
  api_key_env: "{{ llm_api_key_env }}" # Environment variable for API key
{% if llm_provider == "ollama" %}
  base_url: "${OLLAMA_BASE_URL:-http://localhost:11434}"
{% endif %}
  temperature: 0.7             # Creativity (0.0 - 1.0)
  max_tokens: 2000             # Max response length
  streaming: false             # Enable streaming responses

# Agent Configuration
agent:
  # System prompt file
  system_prompt: "{{ llm_primary_prompt_path }}"

  # Tools configuration
  tools: "{{ llm_primary_tools_path }}"

{% if tools | length > 0 %}  # Built-in tools
  allowed_tools:
{% for tool in tools %}    - {{ tool }}
{% endfor %}{% else %}  # No built-in tools selected
  allowed_tools: []{% endif %}

{% if memory_type == "sqlite" %}  # Memory configuration - SQLite (local file)
  memory:
    type: "sqlite"
    config:
      filename: "{{ memory_url }}"
{% elif memory_type == "redis" %}  # Memory configuration - Redis (self-hosted)
  memory:
    type: "redis"
    config:
      url: "{{ memory_url }}"  # Override via REDIS_URL env var
{% elif memory_type == "postgres" %}  # Memory configuration - PostgreSQL
  memory:
    type: "postgres"
    config:
      url: "{{ memory_url }}"  # Override via DATABASE_URL env var
{% elif memory_type == "upstash" %}  # Memory configuration - Upstash Redis (serverless)
  memory:
    type: "upstash"
    config:
      url: "{{ memory_url }}"  # Override via UPSTASH_REDIS_REST_URL env var
      token: "${UPSTASH_REDIS_REST_TOKEN}"
{% elif memory_type == "cloudflare-kv" %}  # Memory configuration - Cloudflare KV
  memory:
    type: "cloudflare-kv"
    config:
      namespace_id: "{{ memory_url }}"
      account_id: "${CF_ACCOUNT_ID}"
      api_token: "${CF_API_TOKEN}"
{% elif memory_type == "cloudflare-d1" %}  # Memory configuration - Cloudflare D1
  memory:
    type: "cloudflare-d1"
    config:
      database_id: "{{ memory_url }}"
      account_id: "${CF_ACCOUNT_ID}"
      api_token: "${CF_API_TOKEN}"
{% elif memory_type == "dynamodb" %}  # Memory configuration - AWS DynamoDB
  memory:
    type: "dynamodb"
    config:
      table_name: "{{ memory_url }}"
      region: "${AWS_REGION:-us-east-1}"
      # Credentials from AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY env vars
{% elif memory_type == "turso" %}  # Memory configuration - Turso (edge SQLite)
  memory:
    type: "turso"
    config:
      url: "{{ memory_url }}"  # Override via TURSO_DATABASE_URL env var
      auth_token: "${TURSO_AUTH_TOKEN}"
{% elif memory_type == "convex" %}  # Memory configuration - Convex
  memory:
    type: "convex"
    config:
      url: "{{ memory_url }}"  # Override via CONVEX_URL env var
      # Note: Deploy the Convex schema first. Run: npx convex dev
{% elif memory_type == "file" %}  # Memory configuration - File-based
  memory:
    type: "file"
    config:
      path: "{{ memory_url }}"
{% else %}  # Memory configuration - In-Memory (default)
  memory:
    type: "buffer"
    max_messages: 10
{% endif %}

  # Compliance configuration
  compliance:
    framework: "hipaa"         # hipaa, soc2, gdpr, pci-dss, none
    audit_logging: true        # Log all actions
    sensitive_data_detection: true
    require_approval:          # Tools requiring human approval
      - "send_email"
      - "delete_data"

  # Network permissions
  network:
    allow:
      - "https://api.openai.com"
      - "https://api.anthropic.com"
      - "https://generativelanguage.googleapis.com"
      - "https://api.duckduckgo.com"
      - "http://localhost:11434"
    block: []

  # Filesystem permissions
  filesystem:
    allow_read:
      - "./data/"
    allow_write:
      - "./logs/"
    block_all:
      - "/etc/"
      - "/var/"

# Logger configuration
logger:
  api_base_url: "https://api.sekuire.ai"
  environment: "development"
  enabled: true
{% if server_mode %}
# Server Configuration
server:
  enabled: true
  framework: "{{ framework }}"
  port: 8000
  host: "0.0.0.0"

  endpoints:
    chat: true
    health: true
    webhook: true
    sekuire_protocol: true

  cors:
    enabled: true
    origins: ["*"]

  auth:
    type: "signed"
{% endif %}
