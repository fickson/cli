{% if language == "python" %}# Development Dockerfile - Hot Reload Enabled
FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt watchfiles

# Copy source code
COPY . .

ENV PORT=8000
EXPOSE 8000

# Hot-reload with watchfiles
CMD ["python", "-m", "watchfiles", "main.main", "."]
{% elif language == "rust" %}# Development Dockerfile - Hot Reload Enabled
FROM rust:1.75-alpine

WORKDIR /app

# Install build dependencies and cargo-watch
RUN apk add --no-cache musl-dev
RUN cargo install cargo-watch

# Copy manifests and build dependencies
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs && cargo build
RUN rm -rf src

# Copy source code
COPY . .

ENV PORT=8000
EXPOSE 8000

# Hot-reload with cargo-watch
CMD ["cargo", "watch", "-x", "run"]
{% else %}# Development Dockerfile - Hot Reload Enabled
FROM node:22-alpine

WORKDIR /app

# Install tsx for TypeScript execution
RUN npm install -g tsx

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

ENV PORT=8000
EXPOSE 8000

# Hot-reload with tsx watch
CMD ["npm", "run", "dev"]
{% endif %}
