# Sekuire Configuration (Multi-LLM Template)
# Generated by: sekuire init --template multi-llm

# Project metadata
project:
  name: "{{ name }}"
  version: "0.1.0"
  description: "Multi-LLM compliant AI agent"
  author: ""
  license: "MIT"

# Identity Configuration (Required for Verification)
identity:
  model: "{{ llm_model }}"
  system_prompt_path: "{{ llm_primary_prompt_path }}"
  tools_path: "{{ llm_primary_tools_path }}"

# Installation / deployment metadata (displayed in the dashboard)
deployment:
  docker_image: "sekuire/agent:{{ name }}"
  notes: "Populate required provider keys below; include tool-specific vars when you add external integrations."
  env:
{% for llm in llm_variants %}
{% if llm.requires_api_key %}
    - name: "{{ llm.api_key_env }}"
      required: true
      secret: true
      description: "{{ llm.display_name }} API key."
      example: "{{ llm.api_key_example }}"
{% endif %}
{% if llm.provider == "ollama" %}
    - name: "OLLAMA_BASE_URL"
      required: false
      secret: false
      description: "Ollama endpoint for local models."
      default_value: "${OLLAMA_BASE_URL:-{{ llm.base_url }}}"
{% endif %}
{% endfor %}
    - name: "SEKUIRE_AGENT_ID"
      required: false
      secret: false
      description: "Agent id used for handshake/server."
      default_value: "{{ name }}"
    - name: "PORT"
      required: false
      secret: false
      description: "HTTP port (if you enable server mode)."
      default_value: "8000"
    - name: "HOST"
      required: false
      secret: false
      description: "Bind address."
      default_value: "0.0.0.0"

# Multiple agent definitions, each optimized for specific LLM
agents:
{% for llm in llm_variants %}
  {{ name }}-{{ llm.agent_suffix }}:
    name: "{{ name }} ({{ llm.display_name }})"
    system_prompt: "./prompts/{{ llm.key }}.md"
    tools: "./tools/{{ llm.key }}.json"
    llm:
      provider: "{{ llm.provider }}"
      model: "{{ llm.model }}"
{% if llm.requires_api_key %}
      api_key_env: "{{ llm.api_key_env }}"
{% endif %}
{% if llm.provider == "ollama" %}
      base_url: "${OLLAMA_BASE_URL:-{{ llm.base_url }}}"
{% endif %}
      temperature: {{ llm.temperature }}
      max_tokens: {{ llm.max_tokens }}
{% if memory_type == "sqlite" %}
    memory:
      type: "sqlite"
      config:
        filename: "{{ memory_url }}"
{% elif memory_type == "redis" %}
    memory:
      type: "redis"
      config:
        url: "{{ memory_url }}"
{% elif memory_type == "postgres" %}
    memory:
      type: "postgres"
      config:
        url: "{{ memory_url }}"
{% elif memory_type == "upstash" %}
    memory:
      type: "upstash"
      config:
        url: "{{ memory_url }}"
        token: "${UPSTASH_REDIS_REST_TOKEN}"
{% elif memory_type == "cloudflare-kv" %}
    memory:
      type: "cloudflare-kv"
      config:
        namespace_id: "{{ memory_url }}"
        account_id: "${CF_ACCOUNT_ID}"
        api_token: "${CF_API_TOKEN}"
{% elif memory_type == "cloudflare-d1" %}
    memory:
      type: "cloudflare-d1"
      config:
        database_id: "{{ memory_url }}"
        account_id: "${CF_ACCOUNT_ID}"
        api_token: "${CF_API_TOKEN}"
{% elif memory_type == "dynamodb" %}
    memory:
      type: "dynamodb"
      config:
        table_name: "{{ memory_url }}"
        region: "${AWS_REGION:-us-east-1}"
{% elif memory_type == "turso" %}
    memory:
      type: "turso"
      config:
        url: "{{ memory_url }}"
        auth_token: "${TURSO_AUTH_TOKEN}"
{% elif memory_type == "convex" %}
    memory:
      type: "convex"
      config:
        url: "{{ memory_url }}"
{% elif memory_type == "file" %}
    memory:
      type: "file"
      config:
        path: "{{ memory_url }}"
{% else %}
    memory:
      type: "buffer"
      max_messages: 10
{% endif %}
    compliance:
      framework: "hipaa"
      audit_logging: true
{% endfor %}

# Shared logger configuration
logger:
  api_base_url: "https://api.sekuire.ai"
  environment: "development"
  enabled: true
