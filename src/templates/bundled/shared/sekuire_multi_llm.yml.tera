# Sekuire Configuration (Multi-LLM Template)
# Generated by: sekuire init --template multi-llm

# Project metadata
project:
  name: "{{ name }}"
  version: "0.1.0"
  description: "Multi-LLM compliant AI agent"
  author: ""
  license: "MIT"

# Identity Configuration (Required for Verification)
identity:
  model: "gpt-4"
  system_prompt_path: "./prompts/openai.md"
  tools_path: "./tools/openai.json"

# Installation / deployment metadata (displayed in the dashboard)
deployment:
  docker_image: "sekuire/agent:{{ name }}"
  notes: "Populate required provider keys below; include tool-specific vars when you add external integrations."
  env:
    - name: "OPENAI_API_KEY"
      required: true
      secret: true
      description: "OpenAI API key."
      example: "sk-..."
    - name: "ANTHROPIC_API_KEY"
      required: false
      secret: true
      description: "Anthropic API key."
      example: "sk-ant-..."
    - name: "GOOGLE_API_KEY"
      required: false
      secret: true
      description: "Google API key (Gemini)."
      example: "..."
    - name: "SEKUIRE_AGENT_ID"
      required: false
      secret: false
      description: "Agent id used for handshake/server."
      default_value: "{{ name }}"
    - name: "PORT"
      required: false
      secret: false
      description: "HTTP port (if you enable server mode)."
      default_value: "8000"
    - name: "HOST"
      required: false
      secret: false
      description: "Bind address."
      default_value: "0.0.0.0"

# Multiple agent definitions, each optimized for specific LLM
agents:
  # OpenAI variant - Optimized for reasoning
  {{ name }}-openai:
    name: "{{ name }} (OpenAI)"
    system_prompt: "./prompts/openai.md"
    tools: "./tools/openai.json"
    llm:
      provider: "openai"
      model: "gpt-4"
      api_key_env: "OPENAI_API_KEY"
      temperature: 0.7
      max_tokens: 2000
    memory:
      type: "buffer"
      max_messages: 10
    compliance:
      framework: "hipaa"
      audit_logging: true

  # Claude variant - Optimized for document analysis
  {{ name }}-claude:
    name: "{{ name }} (Claude)"
    system_prompt: "./prompts/claude.md"
    tools: "./tools/claude.json"
    llm:
      provider: "anthropic"
      model: "claude-3-opus-20240229"
      api_key_env: "ANTHROPIC_API_KEY"
      temperature: 0.9
      max_tokens: 2000
    memory:
      type: "summary"
      max_messages: 20
    compliance:
      framework: "hipaa"
      audit_logging: true

  # Gemini variant - Optimized for multimodal
  {{ name }}-gemini:
    name: "{{ name }} (Gemini)"
    system_prompt: "./prompts/gemini.md"
    tools: "./tools/gemini.json"
    llm:
      provider: "google"
      model: "gemini-pro"
      api_key_env: "GOOGLE_API_KEY"
      temperature: 0.5
      max_tokens: 2000
    memory:
      type: "buffer"
      max_messages: 5
    compliance:
      framework: "hipaa"
      audit_logging: true

  # Ollama variant - Optimized for local/privacy
  {{ name }}-local:
    name: "{{ name }} (Local)"
    system_prompt: "./prompts/ollama.md"
    tools: "./tools/ollama.json"
    llm:
      provider: "ollama"
      model: "llama2"
      base_url: "http://localhost:11434"
      temperature: 0.6
    memory:
      type: "buffer"
      max_messages: 5
    compliance:
      framework: "hipaa"
      audit_logging: true

# Shared logger configuration
logger:
  api_base_url: "https://api.sekuire.ai"
  environment: "development"
  enabled: true
