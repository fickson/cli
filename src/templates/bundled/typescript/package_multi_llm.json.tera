{
  "name": "{{ package_name }}",
  "version": "0.1.0",
  "description": "Sekuire Multi-LLM Agent",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@sekuire/sdk": "^0.1.25",
    "openai": "^6.22.0"{% if include_sqlite %},
    "better-sqlite3": "^12.6.2"{% endif %}
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "@types/node": "^25.3.0"{% if include_sqlite %},
    "@types/better-sqlite3": "^7.6.13"{% endif %}
  }{% if include_sqlite %},
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }{% endif %}
}
