{
  "name": "{{ package_name }}",
  "version": "0.1.0",
  "description": "Sekuire Agent (HTTP Server)",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@sekuire/sdk": "^0.1.25",
{% if framework == "express" %}    "express": "^5.2.1",
    "@types/express": "^5.0.6"
{% elif framework == "fastify" %}    "fastify": "^5.7.4",
    "@fastify/cors": "^11.2.0"
{% elif framework == "hono" %}    "hono": "^4.12.0",
    "@hono/node-server": "^1.19.9"
{% else %}    "express": "^5.2.1",
    "@types/express": "^5.0.6"
{% endif %}{% if include_sqlite %},
    "better-sqlite3": "^12.6.2"
{% endif %}  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "@types/node": "^25.3.0"{% if include_sqlite %},
    "@types/better-sqlite3": "^7.6.13"{% endif %}
  }{% if include_sqlite %},
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }{% endif %}
}
