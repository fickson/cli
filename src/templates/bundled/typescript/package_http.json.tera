{
  "name": "{{ package_name }}",
  "version": "0.1.0",
  "description": "Sekuire Agent (HTTP Server)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@sekuire/sdk": "^0.1.0",
{% if framework == "express" %}    "express": "^4.18.0",
    "@types/express": "^4.17.0"
{% elif framework == "fastify" %}    "fastify": "^4.24.0",
    "@fastify/cors": "^8.4.0"
{% elif framework == "hono" %}    "hono": "^3.11.0",
    "@hono/node-server": "^1.3.0"
{% else %}    "express": "^4.18.0",
    "@types/express": "^4.17.0"
{% endif %}  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "@types/node": "^20.10.0"
  }
}
